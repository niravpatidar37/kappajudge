# Names only. Copy to .env and fill in locally; never commit real values.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://judgecal:<password>@127.0.0.1:15433/judgecal
# LLM keys are read from the shared portfolio env file (path below) or the environment.
PORTFOLIO_ENV_FILE=F:/.secrets/portfolio.env
GROQ_API_KEY=
HF_TOKEN=
ANTHROPIC_API_KEY=
LLM_SPEND_CAP_USD=25
LLM_SPEND_LEDGER=F:/.llm-spend/ledger.jsonl
# Kill switch: false refuses every uncached model call.
LLM_CALLS_ENABLED=true
JUDGE_MODEL=qwen/qwen3.8-27b
SUT_MODEL=openai/gpt-oss-20b
DOUBLE_LABEL_MIN_HOURS=20
