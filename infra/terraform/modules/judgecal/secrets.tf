# Secret Manager: Terraform creates the secret *containers* only. Values are added out of band
# (`gcloud secrets versions add`, see docs/RUNBOOK.md) or, for the two database passwords, written
# through write-only arguments in sql.tf. No secret value is ever in Terraform code, plan or state.

locals {
  secrets = {
    "groq-api-key"      = "Groq API key for the scheduled eval job (judge + system under test)."
    "pg-app-password"   = "Cloud SQL password for judgecal_app (generated by Terraform, write-only)."
    "pg-owner-password" = "Cloud SQL password for judgecal_owner (generated by Terraform, write-only)."
  }

  # Least privilege: which runtime identity may read which secret. The UI never calls a model.
  secret_readers = {
    "groq-api-key"      = ["jobs"]
    "pg-app-password"   = ["ui"]
    "pg-owner-password" = ["jobs"]
  }

  secret_bindings = merge([
    for secret, readers in local.secret_readers : {
      for r in readers : "${secret}:${r}" => { secret = secret, reader = r }
    }
  ]...)
}

resource "google_secret_manager_secret" "s" {
  for_each = local.secrets

  # checkov:skip=CKV_GCP_84:Google-managed encryption keys; CMEK (Cloud KMS) is a documented hardening step (docs/RUNBOOK.md).
  project   = var.project_id
  secret_id = "${local.name}-${each.key}"
  labels    = local.labels

  annotations = {
    description = each.value
  }

  replication {
    auto {}
  }

  depends_on = [google_project_service.apis]
}

resource "google_secret_manager_secret_iam_member" "readers" {
  for_each = local.secret_bindings

  project   = var.project_id
  secret_id = google_secret_manager_secret.s[each.value.secret].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = each.value.reader == "ui" ? google_service_account.ui.member : google_service_account.jobs.member
}
